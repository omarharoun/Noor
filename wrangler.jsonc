{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noor",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-15",

  // The backend Docker image, run as a container behind the Worker.
  "containers": [
    {
      "class_name": "Backend",
      "image": "./Dockerfile",
      // One always-warm instance so the in-process background loops keep
      // running. Bump this only after moving those jobs to cron endpoints.
      "max_instances": 1,
      "instance_type": "standard"
    }
  ],

  // Containers are Durable Objects under the hood.
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],

  // Keep-warm ping every 5 min (< sleepAfter=10m) so the container never sleeps.
  "triggers": { "crons": ["*/5 * * * *"] },

  // All four sites are served by this one Worker; the Rust app routes by Host.
  // custom_domain:true makes Cloudflare manage DNS + TLS for each name — delete
  // any pre-existing CNAME (e.g. the old Railway api record) in that zone first.
  "routes": [
    { "pattern": "norhadi.com", "custom_domain": true },
    { "pattern": "www.norhadi.com", "custom_domain": true },
    { "pattern": "app.norhadi.com", "custom_domain": true },
    { "pattern": "platform.norhadi.com", "custom_domain": true },
    { "pattern": "api.norhadi.com", "custom_domain": true }
  ],

  // Non-secret config. Secrets (DATABASE_URL, JWT_SECRET, MODERN_TREASURY_*,
  // PII_ENCRYPTION_KEY, SENDGRID_API_KEY, ADMIN_PASSWORD, …) go in via
  // `wrangler secret put <NAME>` — never commit them here.
  "vars": {
    "NOOR_ENV": "production",
    "RUST_LOG": "info",
    "EMAIL_FROM": "noreply@norhadi.com",
    "PUBLIC_APP_URL": "https://app.norhadi.com",
    "CORS_ALLOWED_ORIGINS": "https://app.norhadi.com,https://platform.norhadi.com,https://norhadi.com"
  }
}
