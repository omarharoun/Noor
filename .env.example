# ── Database ──────────────────────────────────────────────────────────────
# Full Postgres connection string used by sqlx at runtime and for migrations.
DATABASE_URL="postgresql://noralpay:noralpay_dev_password@localhost:5433/noralpay"

# ── Server ────────────────────────────────────────────────────────────────
# Socket address the API server binds to.
BIND_ADDR="0.0.0.0:8888"

# Publicly reachable base URL (used in webhook callbacks, QR codes, etc.)
PUBLIC_APP_URL="http://localhost:8888"

# ── Column (ACH / wire provider) ─────────────────────────────────────────
COLUMN_API_KEY="col_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
COLUMN_MERCHANT_ACCOUNT_ID="bacc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Modern Treasury (primary payments provider) ───────────────────────────
MODERN_TREASURY_ORG_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MODERN_TREASURY_API_KEY="your-modern-treasury-api-key"
# UUID of the internal ledger / operating account in Modern Treasury
MT_INTERNAL_ACCOUNT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── Plaid (bank-account linking) ──────────────────────────────────────────
PLAID_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PLAID_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# One of: sandbox | development | production
PLAID_ENV="sandbox"

# ── Webhook signing ───────────────────────────────────────────────────────
# Shared secret used to verify inbound webhook payloads (HMAC-SHA256) and to
# sign OUTBOUND merchant webhooks when a merchant has no per-merchant secret.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET="change-me-generate-with-openssl-rand-hex-32"
# Modern Treasury's own webhook signing secret (falls back to WEBHOOK_SECRET).
MODERN_TREASURY_WEBHOOK_SECRET="change-me-mt-webhook-secret"

# ── Operator console login (bootstrap credential; real user store is a follow-up)
ADMIN_EMAIL="admin@noor.local"
ADMIN_PASSWORD="change-me-strong-operator-password"

# Max DB pool connections (optional; default 10)
DATABASE_MAX_CONNECTIONS="10"

# ── Security (used by other workstreams — set before deploying) ───────────
# Secret key for signing JWTs; use a long random string.
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-generate-with-openssl-rand-base64-48"

# Key used for encrypting PII fields at rest.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY="change-me-generate-with-openssl-rand-base64-32"
